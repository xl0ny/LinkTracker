FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /scrapper ./cmd/scrapper

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /scrapper /app/scrapper
COPY cmd/scrapper/config.yaml /app/cmd/scrapper/config.yaml
COPY schemas /app/schemas
EXPOSE 8080
ENTRYPOINT ["/app/scrapper"]
