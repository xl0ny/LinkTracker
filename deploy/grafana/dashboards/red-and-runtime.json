{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "RED: количество HTTP-запросов в секунду",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"$app\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "RED: доля ответов с ошибками (4xx + 5xx) от общего числа запросов, с разбивкой по классам",
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"$app\",status=~\"[45]..\"}[5m])) / sum(rate(http_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "all errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{app=\"$app\",status=~\"4..\"}[5m])) / sum(rate(http_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{app=\"$app\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{app=\"$app\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "C"
        }
      ],
      "title": "HTTP error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "RED: 95-й перцентиль длительности HTTP-запросов",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"$app\"}[5m])) by (le, route))",
          "legendFormat": "{{route}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "RSS процесса Go (память приложения)",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "process_resident_memory_bytes{app=\"$app\"}",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_inuse_bytes{app=\"$app\"}",
          "legendFormat": "heap inuse",
          "refId": "B"
        }
      ],
      "title": "Process memory",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["link-tracker", "red"],
  "templating": {
    "list": [
      {
        "current": { "text": "scrapper", "value": "scrapper" },
        "label": "app",
        "name": "app",
        "options": [
          { "text": "scrapper", "value": "scrapper" },
          { "text": "bot", "value": "bot" }
        ],
        "query": "scrapper,bot",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Link Tracker — RED & Runtime",
  "uid": "link-tracker-red",
  "version": 1
